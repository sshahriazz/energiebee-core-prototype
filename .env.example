# EnergieBee core prototype — local settings. Never commit this file.
PORT=4100
DB_FILE=data/core.db

# Your home (used to look up region, weather, carbon and solar forecast)
SITE_NAME=My home
SITE_POSTCODE=
PV_KWP=
PV_TILT=
# Panel tilt (degrees) and direction (compass bearing, 180 = south), from the installer.
# Leave empty if unknown: nothing is assumed., 90 = east, 270 = west
PV_ORIENTATION=
BATTERY_KWH=

# Sunsynk Connect login (email and password)
SUNSYNK_USERNAME=
SUNSYNK_PASSWORD=
# Plant id from Sunsynk Connect (needed when the login sees more than one plant)
SUNSYNK_PLANT_ID=

# Octopus Energy (API key from your Octopus dashboard, account number A-XXXXXXXX)
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# Tariff codes used for prices when the Octopus account cannot be read (rates are public)
IMPORT_TARIFF_CODE=
EXPORT_TARIFF_CODE=

# How often to sync in the background (minutes) and how many days to load on first run
SYNC_EVERY_MINUTES=10
INITIAL_DAYS=14

# Copied from eb-auth/.env (not used by the first pages yet)
TARIFFSCAN_USERNAME=
TARIFFSCAN_PASSWORD=
EPC_API_TOKEN=
EPC_API_BASE_URL=https://api.get-energy-performance-data.communities.gov.uk
AFD_SERIAL=
AFD_PASSWORD=
AFD_BASE_URL=https://pce.afd.co.uk/afddata.pce
OPENREMOTE_BASE_URL=https://or.energiebee.com
OPENREMOTE_REALM=master
OPENREMOTE_USERNAME=
OPENREMOTE_PASSWORD=
