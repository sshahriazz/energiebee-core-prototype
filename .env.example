# EnergieBee core prototype — local settings. Never commit this file.
PORT=4100
DB_FILE=data/core.db

# Accounts (src/core/users.js, src/core/secrets.js). People sign up at /signup with an email and a password,
# add their home by postcode and connect their own Sunsynk / Octopus logins. Those logins are stored
# encrypted with this key: at least 32 characters, e.g. `openssl rand -hex 32`. Without it no login is
# stored. Changing it later makes the stored logins unreadable (each home then has to connect again).
SECRET_KEY=
# 1 shows the "Viewing as" user switch (no password; the demo server sets it). Leave empty on a real server.
USER_SWITCHER=

# Your home (used to look up region, weather, carbon and solar forecast)
SITE_NAME=My home
SITE_POSTCODE=
PV_KWP=
PV_TILT=
# Panel tilt (degrees) and direction (compass bearing, 180 = south), from the installer.
# Leave empty if unknown: nothing is assumed., 90 = east, 270 = west
PV_ORIENTATION=
BATTERY_KWH=

# Sunsynk Connect login (email and password)
SUNSYNK_USERNAME=
SUNSYNK_PASSWORD=
# Plant id from Sunsynk Connect (needed when the login sees more than one plant)
SUNSYNK_PLANT_ID=

# Octopus Energy (API key from your Octopus dashboard, account number A-XXXXXXXX)
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# Tariff codes used for prices when the Octopus account cannot be read (rates are public)
IMPORT_TARIFF_CODE=
EXPORT_TARIFF_CODE=

# How often to sync in the background (minutes) and how many days to load on first run
SYNC_EVERY_MINUTES=10
INITIAL_DAYS=14

# Retention (src/core/maintenance.js runRetention), run at every start. RETENTION=report (the
# default) only logs what would be deleted; apply deletes it; off skips it. Raw payloads that no
# fact or saved state refers to, older than RAW_RETENTION_DAYS (the newest of each endpoint and
# every quarantined one are kept); sync runs older than SYNC_RUN_RETENTION_DAYS thinned to one per
# day; forecast issues of periods older than FORECAST_RETENTION_DAYS (at least 8) thinned to the
# issues a read can pick. A one-off run: npm run retention (dry run) or npm run retention -- --apply.
RETENTION=report
RAW_RETENTION_DAYS=14
SYNC_RUN_RETENTION_DAYS=90
FORECAST_RETENTION_DAYS=14

# Tariffscanner (FEA) UK tariff catalogue: the core's own credential. With both set, the GB
# tariff_catalogue step sweeps the catalogue at most once a day (src/adapters/tariffscanner.js).
# Its 20 requests a minute are per credential: anything else using the same one shares them.
TARIFFSCAN_USERNAME=
TARIFFSCAN_PASSWORD=

# Not used by the core yet
EPC_API_TOKEN=
EPC_API_BASE_URL=https://api.get-energy-performance-data.communities.gov.uk
AFD_SERIAL=
AFD_PASSWORD=
AFD_BASE_URL=https://pce.afd.co.uk/afddata.pce
OPENREMOTE_BASE_URL=https://or.energiebee.com
OPENREMOTE_REALM=master
OPENREMOTE_USERNAME=
OPENREMOTE_PASSWORD=
