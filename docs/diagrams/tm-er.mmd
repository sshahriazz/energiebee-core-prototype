  thing {
    bigint id PK
    uuid uid UK
    bigint home_id FK
    text kind
    text type FK
    text name
    jsonb attrs
  }
  thing_relation {
    bigint from_id FK
    text from_port
    text rel
    bigint to_id FK
    text to_port
    boolean required
    bigint valid_from
    bigint valid_to
  }
  point {
    bigint id PK
    uuid uid UK
    bigint thing_id FK
    text capability FK
    text key
    text class
    text access
  }
  point_binding {
    bigint point_id FK
    bigint link_id FK
    text external_point
    jsonb mapping
    text role
    int priority
  }
  thing_link {
    bigint id PK
    bigint thing_id FK
    text kind
    bigint hub_id FK
    text external_ref
  }
  control_request {
    bigint id PK
    bigint thing_id FK
    jsonb desired
    text priority
    bigint valid_until
  }
