  MI <==>|grid| INV
  PV ==>|dc| INV
  INV ==>|charge| BAT
  BAT ==>|discharge| INV
  INV ==>|ac| SUP
  SUP ==> EVC ==> EV
  SUP ==> HP
  SUP ==> P1
  SUP ==> P2
  SUP -.-> UNT
  HP -->|heat| R1
  HP -->|heat| R2
  HP -->|heat| R3
  TH -.->|controls| HP
  T1 -.->|controls| R1
  T2 -.->|controls| R2
  T3 -.->|controls| R3

