{
  "name": "energiebee-core-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype of the EnergieBee unified energy core: adapters, bitemporal facts, half-hour build engine and a plain HTML front end.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning src/server.js",
    "serve": "node scripts/supervise.js",
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.js",
    "service:install": "sh scripts/service.sh install",
    "service:uninstall": "sh scripts/service.sh uninstall",
    "service:status": "sh scripts/service.sh status",
    "reset": "rm -f data/core.db data/core.db-wal data/core.db-shm && rm -rf data/raw/*",
    "history:reconstruct": "node --env-file=.env --disable-warning=ExperimentalWarning scripts/reconstruct-history.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
