model app_user {
  id                                         BigInt         @id @default(autoincrement())
  name                                       String
  created_at                                 BigInt
  email                                      String?        @unique(map: "app_user_email")
  role                                       String         @default("owner")
  note                                       String?
  password_hash                              String?
  username                                   String?        @unique(map: "app_user_username")
  pin_hash                                   String?
  failed_logins                              BigInt         @default(0)
  locked_until                               BigInt?
  group_grant                                group_grant[]
  site_grant_site_grant_granted_byToapp_user site_grant[]   @relation("site_grant_granted_byToapp_user")
  site_grant_site_grant_user_idToapp_user    site_grant[]   @relation("site_grant_user_idToapp_user")
  site_group                                 site_group[]
  user_session                               user_session[]
  user_site                                  user_site[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model attribute_def {
  key                 String            @id
  label               String
  unit                String?
  value_type          String
  min_value           Float?
  max_value           Float?
  step                Float?
  allowed_values      String?
  json_shape          String?
  applies_to          String            @default("[\"site\"]")
  origins             String            @default("[\"sourced\",\"provider\",\"user\",\"derived\",\"placeholder\",\"synthetic\"]")
  storage             String            @default("attribute_value")
  site_column         String?
  alias_of            String?
  unverified          BigInt            @default(0)
  description         String?
  refs                String?
  attribute_def       attribute_def?    @relation("attribute_defToattribute_def", fields: [alias_of], references: [key], onDelete: NoAction, onUpdate: NoAction)
  other_attribute_def attribute_def[]   @relation("attribute_defToattribute_def")
  attribute_value     attribute_value[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model attribute_value {
  id            BigInt        @id @default(autoincrement())
  site_id       BigInt?
  device_id     BigInt?
  key           String
  source        String
  value         String
  origin        String
  note          String?
  recorded_at   BigInt
  superseded_at BigInt?
  device        device?       @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_def attribute_def @relation(fields: [key], references: [key], onDelete: NoAction, onUpdate: NoAction)
  site          site?         @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([device_id, key, recorded_at], map: "attribute_value_device", where: raw("(device_id IS NOT NULL)"))
  @@index([site_id, key, recorded_at], map: "attribute_value_site", where: raw("(site_id IS NOT NULL)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model binding {
  id            BigInt  @id @default(autoincrement())
  site_id       BigInt
  role          String
  source_id     BigInt
  valid_from    BigInt?
  valid_to      BigInt?
  recorded_at   BigInt
  superseded_at BigInt?
  reason        String?
  priority      BigInt  @default(0)
  device_id     BigInt?
  device        device? @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site          site    @relation(fields: [site_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source        source  @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([site_id, role], map: "ix_binding_site_role")
}

model binding_default {
  role      String
  source_id BigInt
  priority  BigInt @default(0)
  source    source @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role, source_id])
}

