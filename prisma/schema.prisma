  export_start          BigInt?
  export_end            BigInt?
  verify_status         String?
  verified_at           BigInt?
  applied_late_at       BigInt?
  ack_ref               String?
  device                device        @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_run              plan_run?     @relation(fields: [plan_run_id], references: [id], onUpdate: NoAction)
  raw_payload           raw_payload?  @relation(fields: [readback_raw_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  command               command?      @relation("commandTocommand", fields: [supersedes_command_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_command         command[]     @relation("commandTocommand")
  command_log           command_log[]

  @@index([device_id, acked_at], map: "command_device_acked", where: raw("(status = ANY (ARRAY['acked'::text, 'skipped_unchanged'::text]))"))
  @@index([valid_until], map: "command_expiry", where: raw("(status = ANY (ARRAY['pending'::text, 'sent'::text]))"))
  @@index([plan_run_id], map: "command_plan_run", where: raw("(plan_run_id IS NOT NULL)"))
  @@index([supersedes_command_id], map: "command_supersedes", where: raw("(supersedes_command_id IS NOT NULL)"))
}

